# Host configuration for {{ hostvars[item]['inventory_hostname'] }}

{% if hostvars[item]['tinc_endpoint'] | default('') %}
Address = {{ hostvars[item]['tinc_endpoint'] }}
{% elif item not in tinc_client_only_peers and hostvars[item]['ansible_default_ipv4']['address'] is defined %}
Address = {{ hostvars[item]['ansible_default_ipv4']['address'] }}
{% endif %}

{% if tinc_port != 655 %}
Port = {{ hostvars[item]['tinc_port'] | default(tinc_port) }}
{% endif %}

{% if hostvars[item]['tinc_ip'] | default('') %}
Subnet = {{ hostvars[item]['tinc_ip'] }}/{{ tinc_netmask }}
{% else %}
# Auto-assign tinc IP based on host index
{% set host_index = (groups['all'].index(item) + 1) %}
Subnet = {{ tinc_address_prefix }}.{{ host_index }}/{{ tinc_netmask }}
{% endif %}

# Public key
{% if item == inventory_hostname %}
{{ tinc_public_key }}
{% else %}
{{ hostvars[item]['tinc_public_key'] }}
{% endif %}