#!/bin/bash
# Generated by Ansible - DO NOT EDIT MANUALLY
# Tinc-down script for {{ tinc_netname }} network

# Remove interface from bridge
ip link set dev $INTERFACE nomaster 2>/dev/null || true

# Set interface down
ip link set dev $INTERFACE down 2>/dev/null || true

# Check if bridge has any other interfaces
BRIDGE_INTERFACES=$(ip link show master {{ bridge_interface }} 2>/dev/null | grep -c "master {{ bridge_interface }}" || echo "0")

# If no other interfaces are using the bridge, remove it
if [ "$BRIDGE_INTERFACES" -eq 0 ]; then
    ip link set dev {{ bridge_interface }} down 2>/dev/null || true
    ip link del {{ bridge_interface }} 2>/dev/null || true
    logger "Tinc {{ tinc_netname }}: Bridge {{ bridge_interface }} removed as no interfaces remain"
else
    logger "Tinc {{ tinc_netname }}: Interface $INTERFACE removed from bridge {{ bridge_interface }}"
fi