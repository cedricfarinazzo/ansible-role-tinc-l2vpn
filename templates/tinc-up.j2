#!/bin/bash
# Generated by Ansible - DO NOT EDIT MANUALLY
# Tinc-up script for {{ tinc_netname }} network

# Wait for interface to be ready
sleep 1

# Set interface up
ip link set dev $INTERFACE up

# Create bridge if it doesn't exist
if ! ip link show {{ bridge_interface }} > /dev/null 2>&1; then
    ip link add name {{ bridge_interface }} type bridge
fi

# Add tinc interface to bridge
ip link set dev $INTERFACE master {{ bridge_interface }}

# Configure bridge IP address
{% if bridge_ip %}
BRIDGE_IP="{{ bridge_ip }}"
{% else %}
# Auto-assign bridge IP based on host index
HOST_INDEX=$(echo "{{ groups['all'] }}" | tr ' ' '\n' | grep -n "{{ inventory_hostname }}" | cut -d: -f1)
if [ -z "$HOST_INDEX" ]; then
    HOST_INDEX=1
fi
BRIDGE_IP="{{ bridge_address_prefix }}.$(($HOST_INDEX + 10))"
{% endif %}

# Set bridge IP and bring it up
ip addr add $BRIDGE_IP/{{ bridge_netmask }} dev {{ bridge_interface }} 2>/dev/null || true
ip link set dev {{ bridge_interface }} up

# Enable bridge forwarding
echo 1 > /proc/sys/net/ipv4/conf/{{ bridge_interface }}/forwarding
echo 0 > /proc/sys/net/ipv4/conf/{{ bridge_interface }}/rp_filter

# Log the configuration
logger "Tinc {{ tinc_netname }}: Interface $INTERFACE added to bridge {{ bridge_interface }} with IP $BRIDGE_IP"