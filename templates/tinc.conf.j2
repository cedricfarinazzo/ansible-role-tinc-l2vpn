# Generated by Ansible - DO NOT EDIT MANUALLY
# Tinc configuration for {{ tinc_netname }} network

Name = {{ inventory_hostname }}
Mode = {{ tinc_mode }}
Device = {{ tinc_interface }}
DeviceType = {{ tinc_device_type }}

{% if tinc_port != 655 %}
Port = {{ tinc_port }}
{% endif %}

{% if tinc_cipher != "aes-256-cbc" %}
Cipher = {{ tinc_cipher }}
{% endif %}

{% if tinc_digest != "sha256" %}
Digest = {{ tinc_digest }}
{% endif %}

{% if tinc_mac_length != 8 %}
MACLength = {{ tinc_mac_length }}
{% endif %}

{% if tinc_max_timeout != 300 %}
MaxTimeout = {{ tinc_max_timeout }}
{% endif %}

{% if tinc_ping_timeout != 60 %}
PingTimeout = {{ tinc_ping_timeout }}
{% endif %}

{% if tinc_debug_level > 0 %}
LogLevel = {{ tinc_debug_level }}
{% endif %}

{% if tinc_log_file %}
LogFile = {{ tinc_log_file }}
{% endif %}

{% if tinc_user %}
User = {{ tinc_user }}
{% endif %}

{% if tinc_group %}
Group = {{ tinc_group }}
{% endif %}

{% if tinc_chroot %}
Chroot = yes
{% endif %}

{% if tinc_pid_file %}
PidFile = {{ tinc_pid_file }}
{% endif %}

# Connection configuration
{% if tinc_connect_to | length > 0 %}
{% for host in tinc_connect_to %}
ConnectTo = {{ host }}
{% endfor %}
{% else %}
{% for host in groups['all'] %}
{% if host != inventory_hostname and host not in tinc_client_only_peers %}
ConnectTo = {{ host }}
{% endif %}
{% endfor %}
{% endif %}

# Include private key
PrivateKeyFile = {{ tinc_config_path }}/{{ tinc_netname }}/rsa_key.priv